# Generated by `npm run generate --workspace @lunchmeet/config`.
# Do not edit by hand: regenerate from packages/config/src/catalog.ts.
#
# Copy to .env and fill in. Values shown are development defaults; the API
# boots with an empty .env against the local docker compose stack.

# ----------------------------------------------------------------------
# PostgreSQL
# System of record for every entity, and the pub/sub backbone for realtime.
# Obtain: Local: createdb lunchmeet_dev. Production: Cloud SQL for PostgreSQL, or a managed equivalent.
# ----------------------------------------------------------------------
# The production role must not be a superuser.
# required (secret) -> API host environment
DATABASE_URL=postgresql://lunchmeet_dev:lunchmeet@localhost:5432/lunchmeet_dev

# ----------------------------------------------------------------------
# Google Cloud Storage
# Profile photos, replacing v1's base64-in-Postgres columns.
# Obtain: Local: fake-gcs-server via docker compose. Production: a GCS bucket with a service account scoped to it.
# ----------------------------------------------------------------------
# required -> API host environment
GCP_PROJECT_ID=lunchmeet-dev

# required -> API host environment
GCS_BUCKET=lunchmeet-photos-dev

# Dev only. Must be unset in production.
# optional -> Not a stored value
STORAGE_EMULATOR_HOST=

# Omit on GCP; attach a service account to the workload instead.
# optional (secret) -> API host environment
GCP_SERVICE_ACCOUNT_JSON=

# ----------------------------------------------------------------------
# Better Auth
# Sessions, magic links, and Google/Apple OAuth. Replaces Supabase Auth.
# Obtain: Self-hosted. OAuth credentials come from Google Cloud Console and Apple Developer.
# ----------------------------------------------------------------------
# Rotating this signs every user out.
# required (secret) -> API host environment
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me-before-any-deploy

# required -> API host environment
BETTER_AUTH_URL=http://localhost:8787

# optional (secret) -> API host environment
GOOGLE_CLIENT_ID=

# optional (secret) -> API host environment
GOOGLE_CLIENT_SECRET=

# optional -> API host environment
APPLE_CLIENT_ID=

# optional -> API host environment
APPLE_TEAM_ID=

# optional -> API host environment
APPLE_KEY_ID=

# The .p8 downloads exactly once and cannot be retrieved again.
# optional (secret) -> API host environment
APPLE_PRIVATE_KEY=

# ----------------------------------------------------------------------
# Outbound email
# Delivers magic-link sign-in. Sign-in is unusable if this fails.
# Obtain: Local: Mailpit via docker compose. Production: Resend, Postmark, or SES.
# ----------------------------------------------------------------------
# required -> API host environment
SMTP_HOST=localhost

# required -> API host environment
SMTP_PORT=1025

# optional -> API host environment
SMTP_USER=

# optional (secret) -> API host environment
SMTP_PASSWORD=

# Domain needs SPF, DKIM and DMARC or links land in spam.
# required -> API host environment
EMAIL_FROM=no-reply@lunchmeet.local

# ----------------------------------------------------------------------
# Google Places API (optional)
# Restaurant search, nearby lookup, and place details when hosting a lunch.
# Obtain: Google Cloud Console → Credentials. Restrict by IP and to the Places API only.
# ----------------------------------------------------------------------
# Server-side only. Must never reach the client.
# optional (secret) -> API host environment
GOOGLE_PLACES_API_KEY=

# ----------------------------------------------------------------------
# Expo Push Service (optional)
# Delivers notifications when the app is backgrounded. v1 had none.
# Obtain: expo.dev → Access Tokens. APNs and FCM keys go in the EAS credentials store.
# ----------------------------------------------------------------------
# Optional; enables enhanced security so only your servers can push.
# optional (secret) -> API host environment
EXPO_ACCESS_TOKEN=

# ----------------------------------------------------------------------
# Sentry (optional)
# Error reporting for API and client. v1 was blind to production crashes.
# Obtain: sentry.io → Project Settings → Client Keys (DSN).
# ----------------------------------------------------------------------
# optional -> API host environment
SENTRY_DSN=

# CI only, for uploading source maps.
# optional (secret) -> GitHub Actions secrets
SENTRY_AUTH_TOKEN=

# ----------------------------------------------------------------------
# Public configuration (safe to ship in the mobile bundle)
# ----------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_WS_URL=ws://localhost:8787/ws
