{
  "name": "lunchmeet",
  "version": "2.0.0",
  "private": true,
  "description": "LunchMeet v2 - social lunch meetups. Expo client, Hono API, Postgres.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:services": "docker compose -f docker-compose.dev.yml up -d",
    "dev:services:down": "docker compose -f docker-compose.dev.yml down",
    "dev:services:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "mobile": "npm run start --workspace @lunchmeet/mobile",
    "api": "npm run dev --workspace @lunchmeet/api",
    "db:generate": "npm run generate --workspace @lunchmeet/db",
    "db:migrate": "npm run migrate --workspace @lunchmeet/db",
    "db:seed": "npm run seed --workspace @lunchmeet/db",
    "db:studio": "npm run studio --workspace @lunchmeet/db",
    "doctor": "npm run doctor --workspace @lunchmeet/config",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
